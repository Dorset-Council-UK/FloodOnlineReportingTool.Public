@page "/floodreport/create/secondarycause"

<PageTitle>@FloodReportCreatePages.SecondaryCause.Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url"></GdsBackLink>

<GdsHeading Level="1">@FloodReportCreatePages.SecondaryCause.Title</GdsHeading>

<EditForm EditContext="_editContext" OnSubmit="OnSubmit" FormName="SecondaryCause">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <GdsSpinner Show="_isLoading" ShowMessage="true" />

    <GdsFormGroup Show="!_isLoading">
        <GdsFieldsetGroup>
            <Heading>
                <GdsHeading Level="2" AdditionalCssClasses="govuk-fieldset__heading">Do you know where the water was running off from?</GdsHeading>
            </Heading>
            <Content>
                <GdsHint>Select all that apply</GdsHint>
                <GdsErrorMessage />
                <GdsCheckboxes Options="Model.SecondaryCauseOptions" />
            </Content>
        </GdsFieldsetGroup>
    </GdsFormGroup>

    @if (!_isLoading)
    {
        <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
    }

</EditForm>