@page "/floodreport/create/secondarycause"
@using FloodOnlineReportingTool.Contracts.Shared

<PageTitle>@FloodReportCreatePages.SecondaryCause.Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url"></GdsBackLink>

<GdsHeading Level="1">@FloodReportCreatePages.SecondaryCause.Title</GdsHeading>

<EditForm EditContext="_editContext" OnSubmit="OnSubmit" FormName="SecondaryCause">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <GdsSpinner Show="_isLoading" ShowMessage="true" />

    <GdsFormGroup Show="!_isLoading">
        <GdsFieldsetGroup>
            <GdsFieldsetLegend>
                <GdsFieldsetHeading Level="2" AdditionalCssClasses="govuk-fieldset__heading">Do you know where the water was running off from?</GdsFieldsetHeading>
            </GdsFieldsetLegend>

            <GdsHint>Select all that apply</GdsHint>
            <GdsErrorMessage />

            <GdsCheckboxes For="() => Model.SecondaryCauseOptions">
                @foreach (var secondaryCause in SecondaryCauseOptions)
                {
                    string key = secondaryCause.Id.ToString("N");
                    string id = $"secondary-cause-{key}";
                    bool isNotSure = secondaryCause.Id == SecondaryCauseIds.NotSure;
                    
                    if (isNotSure)
                    {
                        <GdsCheckboxDivider />
                    }
                    
                    <GdsCheckboxItem>
                        <GdsInputCheckbox Id="@id" @bind-Value="@SelectedSecondaryCauseOptions[key]" OnChanged="isChecked => OnSecondaryCauseChanged(isChecked, secondaryCause.Id)" Exclusive="isNotSure" />
                        <GdsCheckboxLabel Text="@secondaryCause.TypeName" />
                    </GdsCheckboxItem>
                }
            </GdsCheckboxes>

        </GdsFieldsetGroup>
    </GdsFormGroup>

    @if (!_isLoading)
    {
        <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
    }

</EditForm>