@page "/floodreport/create/floodduration"
@using FloodOnlineReportingTool.Database.Models.Flood.FloodProblemIds

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url"></GdsBackLink>

<GdsHeading Level="1">@Title</GdsHeading>

<EditForm EditContext="_editContext" OnSubmit="OnSubmit" FormName="FloodDuration">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <GdsSpinner Show="_isLoading" ShowMessage="true" />

    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                The flooding started on
            </dt>
            <dd class="govuk-summary-list__value">
                @(_floodStart.HasValue ? _floodStart.Value.GdsReadable() : "Unknown")
            </dd>
            <dd class="govuk-summary-list__actions">
                <a draggable="false" data-prevent-double-click="true" href="@FloodReportCreatePages.FloodStarted.Url" class="govuk-link">Change<span class="govuk-visually-hidden"> when the flooding started</span></a>
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                Still flooding
            </dt>
            <dd class="govuk-summary-list__value">
                @(_isFloodOngoing ? "Yes" : "No")
            </dd>
            <dd class="govuk-summary-list__actions">
                <a draggable="false" data-prevent-double-click="true" href="@FloodReportCreatePages.FloodStarted.Url" class="govuk-link">Change<span class="govuk-visually-hidden"> is flooding ongoing</span></a>
            </dd>
        </div>
    </dl>

    @if (!_isLoading && _durationOptions.Count <= 0)
    {
        <p class="govuk-error-message">
            <span class="govuk-visually-hidden">Error:</span> <span>The flood duration options are missing, please refresh and try again. If this message continues to appear please raise a bug report.</span>
        </p>
    }

    <GdsFormGroup Show="!_isLoading">
            <GdsFieldsetGroup>
                <GdsFieldsetLegend>
                    <GdsFieldsetHeading Level="2">What was the duration of the flooding?</GdsFieldsetHeading>
                </GdsFieldsetLegend>

                <GdsHint>Select one option.</GdsHint>
                <GdsErrorMessage />

                <GdsRadios @bind-Value="Model.DurationKnownId">
                @foreach (var option in _durationOptions)
                {
                    var conditionalId = option.Value == FloodDurationIds.DurationKnown ? "conditional-known" : null;
                    <GdsRadioItem>
                        <GdsInputRadio Value="@option" ConditionalId="@conditionalId" />
                        <GdsRadioLabel Text="@option.Label" />
                    </GdsRadioItem>
                    if (conditionalId != null)
                    {
                        <GdsRadioConditional Id="@conditionalId">
                            <GdsFormGroup>
                                <GdsLabel Text="Days" />
                                <GdsErrorMessage />
                                <GdsInputNumber @bind-Value="Model.DurationDaysText" @bind-NumberValue="Model.DurationDaysNumber" class="govuk-input govuk-input--width-3" />
                            </GdsFormGroup>

                            <GdsFormGroup>
                                <GdsLabel Text="Hours" />
                                <GdsErrorMessage />
                                <GdsInputNumber @bind-Value="Model.DurationHoursText" @bind-NumberValue="Model.DurationHoursNumber" class="govuk-input govuk-input--width-3" />
                            </GdsFormGroup>
                        </GdsRadioConditional>
                    }
                }
            </GdsRadios>
        </GdsFieldsetGroup>
    </GdsFormGroup>

    @if (!_isLoading)
    {
        <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
    }

</EditForm>