@page "/floodreport/create/temporaryaddress"

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url"></GdsBackLink>

<GdsHeading Level="1">@Title</GdsHeading>

<EditForm EditContext="_editContext" OnSubmit="OnSubmit" FormName="Address">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <GdsSpinner Show="_isSearching" ShowMessage="true" Message="Searching..." />

    @if (!_isSearching && Model.AddressOptions.Count == 0 && Model.IsAddress)
    {
        <p class="govuk-error-message">
            <span class="govuk-visually-hidden">Error:</span> <span>No addresses were found, please check the postcode and search again</span>
        </p>
    }

    <GdsFormGroup Show="Model.AddressOptions.Count > 0">
        @{
            var hintId = "UPRN-hint";
            var errorId = "UPRN-error";
            var describedBy = _editContext.IsValid(() => Model.UPRN) ? hintId : $"{hintId} {errorId}";
        }
        <GdsLabel Text="Choose address" />
        <GdsHint Id="@hintId">Select one option.</GdsHint>
        <GdsErrorMessage Id="@errorId" />
        <InputSelect id="@nameof(Model.UPRN)" @bind-Value="Model.UPRN" aria-describedby="@describedBy">
            <option value=""></option>
            @foreach (var option in Model.AddressOptions)
            {
                <option value="@option.Value" selected="@option.Selected">@option.Label</option>
            }
        </InputSelect>
    </GdsFormGroup>

    <GdsFormGroup>
        <GdsLabel Text="Postcode" />
        @{
            if (Model.UPRN is null && (Model.Easting is not null || Model.Northing is not null))
            {
                <GdsHint>The postcode was added based on the location you selected.</GdsHint>
            }
            else
            {
                <GdsHint>If the address is not showing you can search again with a different postcode.</GdsHint>
            }
        }
        <GdsErrorMessage />
        <GdsInputText @bind-Value="Model.Postcode" class="govuk-input govuk-input--width-10" autocomplete="postal-code" />
        <GdsButton IsSubmit="false" PreventDoubleClick AdditionalCssClasses="govuk-button--secondary"  OnClick="SearchAgain" Text="Search again" />
    </GdsFormGroup>

    <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>

</EditForm>