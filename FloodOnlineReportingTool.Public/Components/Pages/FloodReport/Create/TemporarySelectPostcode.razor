@page "/floodreport/create/temporarypostcode"

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url"></GdsBackLink>

<EditForm EditContext="editContext" OnSubmit="OnSubmit" FormName="CreateFloodReport">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <GdsSpinner Show="_isLoading" ShowMessage="true" />

    <GdsFormGroup Show="!_isLoading">
        <GdsFieldsetGroup>
            <GdsFieldsetLegend>
                <GdsFieldsetHeading Level="1">(Optional) Would you like to log where you are staying?</GdsFieldsetHeading>
            </GdsFieldsetLegend>

            <GdsHint>Select one option and provide a postcode if required.</GdsHint>
            <GdsErrorMessage />

            <GdsRadios @bind-Value="Model.PostcodeKnown">
                <GdsRadioItem>
                    <GdsInputRadio Value="@true" ConditionalId="conditional-known" />
                    <GdsRadioLabel Text="Yes" />
                </GdsRadioItem>
                <GdsRadioConditional Id="conditional-known">
                    <GdsFormGroup>
                        <GdsLabel Text="Please provide the postcode for the property if known" />
                        <GdsErrorMessage />
                        <GdsInputText @bind-Value="Model.Postcode" class="govuk-input govuk-input--width-10" autocomplete="postal-code" />
                    </GdsFormGroup>
                </GdsRadioConditional>
                
                <GdsRadioItem>
                    <GdsInputRadio Value="@false" />
                    <GdsRadioLabel Text="No" />
                </GdsRadioItem>
            </GdsRadios>

        </GdsFieldsetGroup>
    </GdsFormGroup>

    @if (!_isLoading)
    {
        <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
    }

</EditForm>