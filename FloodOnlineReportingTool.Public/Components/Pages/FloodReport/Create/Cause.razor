@page "/floodreport/create/cause"
@using FloodOnlineReportingTool.Contracts.Shared

<PageTitle>@FloodReportCreatePages.Cause.Title</PageTitle>

<GdsBackLink Href="@PreviousPage?.Url"></GdsBackLink>

<GdsHeading Level="1">@FloodReportCreatePages.Cause.Title</GdsHeading>

<EditForm EditContext="_editContext" OnSubmit="OnSubmit" FormName="CauseForm">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <GdsSpinner Show="_isLoading" ShowMessage="true" />

    <GdsFormGroup Show="!_isLoading">
        <GdsFieldsetGroup>
            <GdsFieldsetLegend>
                <GdsFieldsetHeading Level="2">Do you know where the water is coming from?</GdsFieldsetHeading>
            </GdsFieldsetLegend>

            <GdsHint>Select all that apply</GdsHint>
            <GdsErrorMessage />

            <GdsCheckboxes For="() => Model.CauseOptions">
                @foreach (var cause in CauseOptions)
                {
                    string key = cause.Id.ToString("N");
                    string id = $"flood-cause-{key}";
                    bool isNotSure = cause.Id == PrimaryCauseIds.NotSure;
                    
                    if (isNotSure)
                    {
                        <GdsCheckboxDivider />
                    }
                    
                    <GdsCheckboxItem>
                        <GdsInputCheckbox Id="@id" @bind-Value="@SelectedCauseOptions[key]" OnChanged="isChecked => OnCauseChanged(isChecked, cause.Id)" Exclusive="isNotSure" />
                        <GdsCheckboxLabel Text="@cause.TypeName" />
                    </GdsCheckboxItem>
                }
            </GdsCheckboxes>

        </GdsFieldsetGroup>
    </GdsFormGroup>

    @if (!_isLoading)
    {
        <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
    }

</EditForm>