@page "/floodreport/create/propertytype"

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url"></GdsBackLink>

<GdsHeading Level="1">@Title</GdsHeading>

<EditForm EditContext="_editContext" OnSubmit="OnSubmit" FormName="PropertyType">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <GdsSpinner Show="_isLoading" ShowMessage="true" />

    @if (!string.IsNullOrWhiteSpace(_addressPreview))
    {
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key govuk-!-width-one-quarter govuk-!-padding-right-1">
                    Location
                </dt>
                <dd class="govuk-summary-list__value">
                    @_addressPreview
                </dd>
                <dd class="govuk-summary-list__actions">
                    @if (Model.IsAddress)
                    {
                        <a draggable="false" data-prevent-double-click="true" href="@FloodReportCreatePages.Address.Url" class="govuk-link">Change<span class="govuk-visually-hidden"> address</span></a>
                    } else
                    {
                        <a draggable="false" data-prevent-double-click="true" href="@FloodReportCreatePages.Location.Url" class="govuk-link">Change<span class="govuk-visually-hidden"> location</span></a>
                    }
                    
                </dd>
            </div>
        </dl>
    }

    @if (Model.ResponsibleOrganisations.Count > 0)
    {
        <GdsHeading Level="2">Information sharing</GdsHeading>
        <p>Details of this report will be shared with the following flood risk organisations.</p>
        @foreach (var org in Model.ResponsibleOrganisations)
        {
            <GdsGridRow AdditionalCssClasses="govuk-!-margin-top-3">
                <GdsGridColumn Width="GdsGridColumnWidth.OneQuarter">
                    <a href="@org.Website" target="_blank">
                        <img src="@org.Logo" alt="Visit the @org.Name website" class="govuk-!-width-full">
                    </a>
                </GdsGridColumn>
                <GdsGridColumn Width="GdsGridColumnWidth.ThreeQuarters">@org.Description</GdsGridColumn>
            </GdsGridRow>
        }
    }

    <GdsFormGroup Show="Model.PropertyOptions.Count > 0">
        <GdsFieldsetGroup>
            <GdsFieldsetLegend>
                <GdsFieldsetHeading Level="2">Property type</GdsFieldsetHeading>
            </GdsFieldsetLegend>

            <GdsHint>
                <div>Select one option.</div>
                @if (!string.IsNullOrWhiteSpace(_classification))
                {
                    <div>The selected address/location is listed as @_classification. Select a different property type if this is incorrect.</div>
                }
            </GdsHint>
            <GdsErrorMessage />

            <GdsRadios @bind-Value="Model.Property">
                @foreach (var propertyOptionType in Model.PropertyOptions)
                {
                    <GdsRadioItem>
                        <GdsInputRadio Value="@propertyOptionType.Value" />
                        <GdsRadioLabel Text="@propertyOptionType.Label" />
                    </GdsRadioItem>
                }
            </GdsRadios>
        </GdsFieldsetGroup>
    </GdsFormGroup>

    <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>

</EditForm>
