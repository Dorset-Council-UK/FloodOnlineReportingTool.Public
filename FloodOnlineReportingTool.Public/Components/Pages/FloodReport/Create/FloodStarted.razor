@page "/floodreport/create/floodstarted"

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url"></GdsBackLink>

<EditForm EditContext="_editContext" OnSubmit="OnSubmit" FormName="FloodStarted">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <GdsSpinner Show="_isLoading" ShowMessage="true" />

    <GdsFormGroup>
        <GdsInputDate Id="flood-start" For="() => Model.StartDate" Show="!_isLoading">
            <Heading>
                <GdsHeading Level="1">When did the flooding start?</GdsHeading>
            </Heading>
            <Hint>For example, 27 3 2024</Hint>
        </GdsInputDate>
    </GdsFormGroup>

    <GdsFormGroup>
        <GdsFieldsetGroup>
            <GdsFieldsetLegend>
                <GdsFieldsetHeading Level="2">Is the flooding ongoing?</GdsFieldsetHeading>
            </GdsFieldsetLegend>

            <GdsHint>Select one option.</GdsHint>
            <GdsErrorMessage />

            <GdsRadios @bind-Value="Model.IsFloodOngoing">
                <GdsRadioItem>
                    <GdsInputRadio Value="true"  />
                    <GdsRadioLabel Text="Yes" />
                </GdsRadioItem>
                <GdsRadioItem>
                    <GdsInputRadio Value="false"  />
                    <GdsRadioLabel Text="No" />
                </GdsRadioItem>
            </GdsRadios>
        </GdsFieldsetGroup>
    </GdsFormGroup>

    @if (!_isLoading)
    {
        <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
    }

</EditForm>
