@page "/floodreport/create/floodareas"

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url"></GdsBackLink>

<GdsHeading Level="1">@Title</GdsHeading>

<EditForm EditContext="_editContext" OnSubmit="OnSubmit" FormName="FloodAreas">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <GdsSpinner Show="_isLoading" ShowMessage="true" />

    <GdsFormGroup Show="Model.ShowResidential">
        <GdsFieldsetGroup>
            <GdsFieldsetLegend>
                <GdsFieldsetHeading Level="2">Which areas of the residential property were flooded?</GdsFieldsetHeading>
            </GdsFieldsetLegend>
            
            <GdsHint>Select all that apply</GdsHint>
            <GdsErrorMessage />

            <GdsCheckboxes>
                @foreach (var residentialFloodArea in ResidentialOptions)
                {
                    string key = residentialFloodArea.Id.ToString("N");
                    string id = $"residential-flood-area-{key}";
                    bool isNotSure = residentialFloodArea.TypeName.Equals("Not sure", StringComparison.OrdinalIgnoreCase);

                    if (isNotSure)
                    {
                        <GdsCheckboxDivider />
                    }

                    <GdsCheckboxItem>
                        <GdsInputCheckbox Id="@id" @bind-Value="@SelectedResidentialOptions[key]" OnChanged="isChecked => OnResidentialChanged(isChecked, residentialFloodArea.Id)" Exclusive="isNotSure" />
                        <GdsCheckboxLabel Text="@residentialFloodArea.TypeName" />
                    </GdsCheckboxItem>
                }
            </GdsCheckboxes>
        </GdsFieldsetGroup>
    </GdsFormGroup>

    <GdsFormGroup Show="Model.ShowCommercial">
        <GdsFieldsetGroup>
            <GdsFieldsetLegend>
                <GdsFieldsetHeading Level="2">Which areas of the commercial property were flooded?</GdsFieldsetHeading>
            </GdsFieldsetLegend>

            <GdsHint>Select all that apply</GdsHint>
            <GdsErrorMessage />

            <GdsCheckboxes>
                @foreach (var commercialFloodArea in CommercialOptions)
                {
                    string key = commercialFloodArea.Id.ToString("N");
                    string id = $"commercial-flood-area-{key}";
                    bool isNotSure = commercialFloodArea.TypeName.Equals("Not sure", StringComparison.OrdinalIgnoreCase);

                    if (isNotSure)
                    {
                        <GdsCheckboxDivider />
                    }

                    <GdsCheckboxItem>
                        <GdsInputCheckbox Id="@id" @bind-Value="@SelectedCommercialOptions[key]" OnChanged="isChecked => OnCommercialChanged(isChecked, commercialFloodArea.Id)" Exclusive="isNotSure" />
                        <GdsCheckboxLabel Text="@commercialFloodArea.TypeName" />
                    </GdsCheckboxItem>
                }
            </GdsCheckboxes>
        </GdsFieldsetGroup>
    </GdsFormGroup>

    @if (!_isLoading && !Model.ShowResidential && !Model.ShowCommercial)
    {
        <p class="govuk-error-message">
            <span class="govuk-visually-hidden">Error:</span> <span>There was a problem working out what type of property you have. Please try again but if this issue happens again then please report a bug.</span>
        </p>
    }
    <GdsFormGroup>
        <GdsFieldsetGroup>
            <GdsFieldsetLegend>
                <GdsFieldsetHeading Level="2">Did you have to evacuate the property?</GdsFieldsetHeading>
            </GdsFieldsetLegend>

            <GdsHint>Select one option.</GdsHint>
            <GdsErrorMessage />

            <GdsRadios @bind-Value="Model.IsUninhabitable">
                <GdsRadioItem>
                    <GdsInputRadio Value="true" />
                    <GdsRadioLabel Text="Yes" />
                </GdsRadioItem>

                <GdsRadioItem>
                    <GdsInputRadio Value="false" />
                    <GdsRadioLabel Text="No" />
                </GdsRadioItem>
            </GdsRadios>
        </GdsFieldsetGroup>
    </GdsFormGroup>

    <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>

</EditForm>
