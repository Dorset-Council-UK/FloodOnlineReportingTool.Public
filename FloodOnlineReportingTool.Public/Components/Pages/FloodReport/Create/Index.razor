@page "/floodreport/create"

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url"></GdsBackLink>

<EditForm EditContext="editContext" OnSubmit="OnSubmit" FormName="CreateFloodReport">
    <FluentValidationValidator />
    <GdsErrorSummary />

    <GdsSpinner Show="_isLoading" ShowMessage="true" />

    <GdsFormGroup Show="!_isLoading">
        <GdsFieldsetGroup>
            <GdsFieldsetLegend>
                <GdsFieldsetHeading Level="2">Are you reporting an address or property?</GdsFieldsetHeading>
            </GdsFieldsetLegend>

            <GdsHint>This would be a location with a Royal Mail postal address rather than a structure or land.</GdsHint>
            <GdsErrorMessage />

            <GdsRadios @bind-Value="Model.IsAddress">

                <GdsRadioItem>
                    <GdsInputRadio Value="@true" />
                    <GdsRadioLabel Text="Yes" />
                </GdsRadioItem>

                <GdsRadioItem>
                    <GdsInputRadio Value="@false" />
                    <GdsRadioLabel Text="No" />
                </GdsRadioItem>
                
            </GdsRadios>
        </GdsFieldsetGroup>
    </GdsFormGroup>

    @if (!_isLoading)
    {
        <p><GdsButton IsSubmit PreventDoubleClick Text="Continue" /></p>
    }

</EditForm>