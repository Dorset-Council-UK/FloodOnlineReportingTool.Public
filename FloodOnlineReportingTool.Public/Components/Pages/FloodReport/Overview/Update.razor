@page "/floodreport/update/{eligibilityCheckId:guid}"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBreadcrumbs Items="@Breadcrumbs" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        @if (_updateModel == null)
        {
            <GdsWarning Text="Flood report not found" />
            <div><GdsLink draggable="false" data-prevent-double-click="true" Href="@FloodReportPages.Overview.Url">@FloodReportPages.Overview.Title</GdsLink></div>
        }
        else
        {
            <EditForm EditContext="_editContext" OnSubmit="OnSubmit" FormName="UpdateEligibilityCheck">
                <FluentValidationValidator />
                <GdsErrorSummary />

                @* TODO - Add warning text *@
                <GdsWarning Text="To do..." />

                <div>Created: @_updateModel.CreatedUtc.GdsReadable()</div>
                @if (_updateModel.UpdatedUtc != null)
                {
                    <div>Updated: @_updateModel.UpdatedUtc.GdsReadable()</div>
                }

                <GdsFormGroup>
                    <GdsLabel Text="UPRN" />
                    <GdsErrorMessage />
                    <GdsInputNumber @bind-Value="_updateModel.UprnText" @bind-NumberValue="_updateModel.UprnNumber" />
                </GdsFormGroup>

                <GdsFormGroup>
                    <GdsLabel Text="Easting" />
                    <GdsErrorMessage />
                    <GdsInputNumber @bind-Value="_updateModel.EastingText" @bind-NumberValue="_updateModel.EastingNumber" />
                </GdsFormGroup>

                <GdsFormGroup>
                    <GdsLabel Text="Northing" />
                    <GdsErrorMessage />
                    <GdsInputNumber @bind-Value="_updateModel.NorthingText" @bind-NumberValue="_updateModel.NorthingNumber" />
                </GdsFormGroup>

                <GdsFormGroup>
                    <GdsLabel Text="Location description" />
                    <GdsErrorMessage />
                    <GdsInputText @bind-Value="_updateModel.LocationDesc" />
                </GdsFormGroup>
            </EditForm>
        }
    </Authorized>
</AuthorizeView>