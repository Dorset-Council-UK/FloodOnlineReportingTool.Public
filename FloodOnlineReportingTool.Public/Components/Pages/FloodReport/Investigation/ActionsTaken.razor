@page "/floodreport/investigation/actionstaken"
@using FloodOnlineReportingTool.Database.Models.Flood
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationActionTaken">
            <FluentValidationValidator />
            <GdsErrorSummary />

            @if (!_isLoading && Model.ActionsTakenOptions.Count <= 0)
            {
                <p class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span> <span>The actions taken options are missing, please refresh and try again. If this message continues to appear please raise a bug report.</span>
                </p>
            }

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">What actions did you take to deal with the flood?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>Select all that apply</GdsHint>
                    <GdsErrorMessage />

                    <GdsCheckboxes For="() => Model.ActionsTakenOptions">
                        @foreach (var actionTaken in ActionsTakenOptions)
                        {
                            string key = actionTaken.Id.ToString("N");
                            string id = $"action-taken-{key}";
                            bool noActionTaken = actionTaken.Id == FloodMitigationIds.NoActionTaken;
                            var conditionalId = actionTaken.Id == FloodMitigationIds.OtherAction ? "conditional-other" : null;

                            if (noActionTaken)
                            {
                                <GdsCheckboxDivider />
                            }

                            <GdsCheckboxItem>
                                <GdsInputCheckbox Id="@id" @bind-Value="@SelectedActionsTakenOptions[key]" OnChanged="isChecked => OnActionsTakenChanged(isChecked, actionTaken.Id)" Exclusive="noActionTaken" />
                                <GdsCheckboxLabel Text="@actionTaken.TypeName" />
                            </GdsCheckboxItem>

                            if(conditionalId != null)
                            {
                                <GdsCheckboxConditional Id="@conditionalId">
                                    <GdsFormGroup AdditionalCssClasses="govuk-character-count govuk-!-margin-top-4" DataModule="govuk-character-count" DataMaxLength="100">
                                        <h2 class="govuk-label-wrapper">
                                            <GdsLabel Text="Can you provide more detail of the action you took?" AdditionalCssClasses="govuk-label--m" />
                                        </h2>
                                        <GdsHint>Do not include personal or financial information</GdsHint>
                                        <GdsErrorMessage />
                                        <InputTextArea id="@nameof(Model.OtherAction)" @bind-Value="Model.OtherAction" class="govuk-textarea govuk-js-character-count" rows="5" />
                                        <div id="@($"{nameof(Model.OtherAction)}-info")" class="govuk-hint govuk-character-count__message">You can enter up to 100 characters</div>
                                    </GdsFormGroup>
                                </GdsCheckboxConditional>
                            }
                        }
                    </GdsCheckboxes>

                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
