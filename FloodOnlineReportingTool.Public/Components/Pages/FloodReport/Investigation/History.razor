@page "/floodreport/investigation/history"
@using Microsoft.AspNetCore.Components.Authorization
@using FloodOnlineReportingTool.Database.Models.Status

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage?.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationHistory">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            @if (!_isLoading && _historyOfFloodingOptions.Count <= 0)
            {
                <p class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span> <span>The flooding history options are missing, please refresh and try again. If this message continues to appear please raise a bug report.</span>
                </p>
            }

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Does this location have a history of flooding?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.HistoryOfFloodingId">
                        @foreach (var option in _historyOfFloodingOptions)
                        {
                            var conditionalId = option.Id == RecordStatusIds.Yes ? "conditional-known" : null;
                            <GdsRadioItem>
                                <GdsInputRadio Value="@option.Id" ConditionalId="@conditionalId" />
                                <GdsRadioLabel Text="@option.Text" />
                            </GdsRadioItem>

                            @if (conditionalId is not null)
                            {
                                <GdsRadioConditional Id="conditional-known">
                                    <GdsLabel Text="Describe the flooding history" />
                                    <GdsHint>Do not include personal or financial information</GdsHint>
                                    <GdsErrorMessage />
                                    <InputTextArea id="@nameof(Model.HistoryOfFloodingDetails)" @bind-Value="Model.HistoryOfFloodingDetails" class="govuk-textarea govuk-js-character-count" rows="5" />
                                    <div id="@($"{nameof(Model.HistoryOfFloodingDetails)}-info")" class="govuk-hint govuk-character-count__message">You can enter up to 200 characters</div>
                                </GdsRadioConditional>
                            }
                        }
                    </GdsRadios>

                </GdsFieldsetGroup>
            </GdsFormGroup>

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2" AdditionalCssClasses="govuk-fieldset__heading">
                            Is the property insured against flood damage?
                        </GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.PropertyInsuredId">
                    @foreach (var option in _propertyInsuredOptions)
                    {
                        <GdsRadioItem>
                            <GdsInputRadio Value="@option.Id" />
                            <GdsRadioLabel Text="@option.Text" />
                        </GdsRadioItem>
                        }
                    </GdsRadios>

                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
