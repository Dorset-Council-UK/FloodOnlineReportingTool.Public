@using FloodOnlineReportingTool.Database.Models.Status
 <div id="peak-depth-form">
    <EditForm Model="@Item" OnValidSubmit="OnValidSubmit">
        <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            <GdsFormGroup Show="!_isLoading">
            <GdsHint>
                <div>You will have the option to add a maximum depth for a particular location.</div>
                <div>You may be able to measure the depth from a tide mark on a wall.</div>
            </GdsHint>
            <GdsErrorMessage />
       
            <GdsFormGroup>
                <GdsLabel Text="Describe the location of the depth" />
                <GdsHint>Be as succinct as possible. Example: Kitchen facing back garden with drain</GdsHint>
                <GdsInputText Id="depthLocation" class="govuk-input" @bind-Value="Model.DepthLocation"></GdsInputText>      
            </GdsFormGroup>         

            <GdsFormGroup>
                <GdsLabel Text="What is the depth?" />
                <GdsHint>Total centimetres, Example: 5</GdsHint>
                <GdsErrorMessage />
                <div class="govuk-input__wrapper">
                    <GdsInputText @bind-Value="Model.PeakCentimetresText" class="govuk-input govuk-input--width-3" spellcheck="false" inputmode="numeric" />
                    <div class="govuk-input__suffix" aria-hidden="true">cm</div>
                </div>
                @if(Model.PeakCentimetres.HasValue)
                {
                    <p>This is roughly equal to @Model.PeakFeetAndInches</p>
                }
            </GdsFormGroup>      

            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
</div>