@page "/floodreport/investigation/entry"
@using FloodOnlineReportingTool.Database.Models.Flood.FloodProblemIds
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationEntry">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Do you know how the water entered?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>
                        
                    <GdsHint>Select all that apply</GdsHint>
                    <GdsErrorMessage />

                    <GdsCheckboxes For="() => Model.EntryOptions">
                        @foreach (var floodEntry in FloodEntryOptions)
                        {
                            string key = floodEntry.Id.ToString("N");
                            string id = $"flood-entry-{key}";
                            bool isNotSure = floodEntry.Id == FloodEntryIds.NotSure;
                            var conditionalId = floodEntry.Id == FloodEntryIds.Other ? "conditional-other" : null;

                            if (isNotSure)
                            {
                                <GdsCheckboxDivider />
                            }

                            <GdsCheckboxItem>
                                <GdsInputCheckbox Id="@id" @bind-Value="@SelectedFloodEntryOptions[key]" OnChanged="isChecked => OnFloodEntryChanged(isChecked, floodEntry.Id)" Exclusive="isNotSure" />
                                <GdsCheckboxLabel Text="@floodEntry.TypeName" />
                            </GdsCheckboxItem>

                            if (conditionalId != null)
                            {
                                <GdsCheckboxConditional Id="@conditionalId">
                                    <GdsFormGroup AdditionalCssClasses="govuk-character-count govuk-!-margin-top-4" DataModule="govuk-character-count" DataMaxLength="100">
                                        <h2 class="govuk-label-wrapper">
                                            <GdsLabel Text="Can you provide more detail of how the water entered?" AdditionalCssClasses="govuk-label--m" />
                                        </h2>
                                        <GdsHint>Do not include personal or financial information</GdsHint>
                                        <GdsErrorMessage />
                                        <InputTextArea id="@nameof(Model.WaterEnteredOther)" @bind-Value="Model.WaterEnteredOther" class="govuk-textarea govuk-js-character-count" rows="5" />
                                        <div id="@($"{nameof(Model.WaterEnteredOther)}-info")" class="govuk-hint govuk-character-count__message">You can enter up to 100 characters</div>
                                    </GdsFormGroup>
                                </GdsCheckboxConditional>
                            }
                        }
                    </GdsCheckboxes>

                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
