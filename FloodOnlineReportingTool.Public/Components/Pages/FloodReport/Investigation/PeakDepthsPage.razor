@page "/floodreport/investigation/peakdepthspage"
<h3>Peak depths</h3>


@if (Model?.Any() == true)
{
    <p>@Model.Count() items found</p>
<table>
<thead>
    <tr></tr>
</thead>
<tbody>
            @foreach (var item in Model)
            {
                <tr>
                <td>@item.InsideCentimetresNumber</td>
                <td>@item.OutsideCentimetresNumber</td>
                </tr>
            } 

</tbody>
</table>
}
else
{
    <p>No items found</p>
}


<PeakDepth OnAdd="AddPeakDepth"
           Item="@PeakDepthModel" />