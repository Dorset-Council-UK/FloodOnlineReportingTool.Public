@page "/floodreport/investigation/internal"
@using FloodOnlineReportingTool.Database.Models.Status
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnSubmit="OnSubmit" FormName="InvestigationInternalWhen">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Do you know when the water entered?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>
                        If you don't have an exact date and time it can still be useful to let us know roughly when the water entered the property.
                        This helps us understand how the flood incident developed.
                    </GdsHint>
                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.WhenWaterEnteredKnownId">
                        @foreach (var option in _whenWaterEnteredOptions)
                        {
                            var conditionalId = option.Id == RecordStatusIds.Yes ? "conditional-known" : null;
                            <GdsRadioItem>
                                <GdsInputRadio Value="@option.Id" ConditionalId="@conditionalId" />
                                <GdsRadioLabel Text="@option.Text" />
                            </GdsRadioItem>

                            if (conditionalId != null)
                            {
                                <GdsRadioConditional Id="@conditionalId">
                                    <GdsFormGroup>
                                        <GdsLabel Text="When did the flooding enter the property?" />
                                        <GdsHint>For example, 27 3 2024</GdsHint>
                                        <GdsInputDate Id="water-entered" For="() => Model.WhenWaterEnteredDate"></GdsInputDate>
                                    </GdsFormGroup>

                                    <GdsFormGroup>
                                        <GdsLabel Text="Do you know what time? (optional)" />
                                        <GdsHint>
                                            <div>For example, 2pm or 14:00</div>
                                            <div>Please put the time if known or 9am for morning and 2pm for afternoon if giving an estimate.</div>
                                        </GdsHint>
                                        <GdsErrorMessage />
                                        <GdsInputText @bind-Value="Model.TimeText" class="govuk-input govuk-input--width-5" autocomplete="date-time" spellcheck="false" inputmode="numeric" />
                                    </GdsFormGroup>
                                </GdsRadioConditional>
                            }
                        }
                    </GdsRadios>

                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
