@page "/floodreport/investigation/confirmation"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBreadcrumbs Items="Breadcrumbs" />

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        @if (_investigation == null)
        {
            <GdsHeading Level="1">@Title</GdsHeading>
            <GdsWarning Text="We cannot find your investigation." />
        }
        else
        {
            <GdsPanel Title="@Title" AdditionalCssClasses="govuk-panel--confirmation">
                Created on @_investigation.CreatedUtc.GdsReadable()
            </GdsPanel>

            <p>Thank you for taking the time to complete this investigation.</p>
            
            <section id="what-happens-next">
                <GdsHeading Level="2">What happens next</GdsHeading>

                <p>The responsible organisation that requested you complete the form will now be able to access the additional information you have provided. This will be used as part of the ongoing investigation work.</p>

                <p>You can return the manage reports page to view this and any other reports allowing you to see any updates</p>

                <GdsStartButton Href="@FloodReportPages.Overview.Url" Text="Manage an existing reports" />

            </section>
        }
    </Authorized>
</AuthorizeView>
