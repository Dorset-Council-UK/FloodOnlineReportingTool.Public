@page "/floodreport/investigation/communityimpact"
@using Microsoft.AspNetCore.Components.Authorization
@using FloodOnlineReportingTool.Database.Models.Flood

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationCommunityImpact">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            @if (!_isLoading && Model.CommunityImpactOptions.Count <= 0)
            {
                <p class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span> <span>The community impact options are missing, please refresh and try again. If this message continues to appear please raise a bug report.</span>
                </p>
            }

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2" AdditionalCssClasses="govuk-fieldset__heading">Did the flooding restrict parts of the community?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>Select all that apply</GdsHint>
                    <GdsErrorMessage />
                    
                    <GdsCheckboxes For="() => Model.CommunityImpactOptions">
                        @foreach (var communityImpact in CommunityImpactOptions)
                        {
                            string key = communityImpact.Id.ToString("N");
                            string id = $"community-impact-{key}";
                            bool noCommunityImpact = communityImpact.Id == FloodImpactIds.CommunityImpactNotSure;
                            
                            if (noCommunityImpact)
                            {
                                <GdsCheckboxDivider />
                            }
                           
                            <GdsCheckboxItem>
                                <GdsInputCheckbox Id="@id" @bind-Value="@SelectedCommunityImpactOptions[key]" OnChanged="isChecked => OnCommunityImpactChanged(isChecked, communityImpact.Id)" Exclusive="noCommunityImpact" />
                                <GdsCheckboxLabel Text="@communityImpact.TypeName" />
                            </GdsCheckboxItem>
                        }
                    </GdsCheckboxes>

                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
