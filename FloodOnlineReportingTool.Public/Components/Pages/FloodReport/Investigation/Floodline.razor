@page "/floodreport/investigation/floodline"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationFloodline">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            @if (!_isLoading && _timelyOptions.Count <= 0)
            {
                <p class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span> <span>The floodline warning timely options are missing, please refresh and try again. If this message continues to appear please raise a bug report.</span>
                </p>
            }

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Was the floodline warning timely?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>
                        <div>Select one option.</div>
                        <div>The message should have arrived in time for you to act, accepting that some flooding can start very quickly.</div>
                    </GdsHint>
                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.WarningTimelyId">
                        @foreach (var timelyOptionType in _timelyOptions)
                        {
                            <GdsRadioItem>
                                <GdsInputRadio Value="@timelyOptionType.Id" />
                                <GdsRadioLabel Text="@timelyOptionType.Text" />
                            </GdsRadioItem>     
                        }
                    </GdsRadios>
                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading && _appropriateOptions.Count <= 0)
            {
                <p class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span> <span>The floodline warning appropriate options are missing, please refresh and try again. If this message continues to appear please raise a bug report.</span>
                </p>
            }

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Was the warning message correctly worded?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>
                        <div>Select one option.</div>
                        <div>The warning should have provided the information you needed.</div>
                    </GdsHint>
                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.WarningAppropriateId">
                        @foreach (var appropriateOptionType in _appropriateOptions)
                        {
                            <GdsRadioItem>
                                <GdsInputRadio Value="@appropriateOptionType.Id" />
                                <GdsRadioLabel Text="@appropriateOptionType.Text" />
                            </GdsRadioItem>
                        }
                    </GdsRadios>
                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
