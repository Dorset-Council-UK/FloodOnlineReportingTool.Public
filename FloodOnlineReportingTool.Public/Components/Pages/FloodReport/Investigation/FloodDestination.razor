@page "/floodreport/investigation/flooddestination"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationDestination">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Do you know where the water was going?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>Select all that apply</GdsHint>
                    <GdsErrorMessage />

                    <GdsCheckboxes For="() => Model.DestinationOptions">
                        @foreach (var destination in DestinationOptions)
                        {
                            string key = destination.Id.ToString("N");
                            string id = $"flood-destination-{key}";
                            bool isNotSure = destination.Id == Database.Models.Flood.FloodProblemIds.FloodDestinationIds.NotSure;
                            if (isNotSure)
                            {
                                <GdsCheckboxDivider />
                            }
                            <GdsCheckboxItem>
                                <GdsInputCheckbox Id="@id" @bind-Value="@SelectedDestinationOptions[key]" OnChanged="isChecked => OnDestinationChanged(isChecked, destination.Id)" Exclusive="isNotSure" />
                                <GdsCheckboxLabel Text="@destination.TypeName" />
                            </GdsCheckboxItem>
                        }
                    </GdsCheckboxes>

                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
