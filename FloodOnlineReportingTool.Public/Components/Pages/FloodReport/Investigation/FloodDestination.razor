@page "/floodreport/investigation/flooddestination"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationDestination">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <Heading>
                        <GdsHeading Level="2" AdditionalCssClasses="govuk-fieldset__heading">Do you know where the water was going?</GdsHeading>
                    </Heading>
                    <Content>
                        <GdsHint>Select all that apply</GdsHint>
                        <GdsErrorMessage />
                        <GdsCheckboxes Options="Model.DestinationOptions" />
                    </Content>
                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
