@page "/floodreport/investigation/warnings"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationWarnings">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            @if (!_isLoading && _registeredWithFloodlineOptions.Count <= 0)
            {
                <p class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span> <span>The floodline warning options are missing, please refresh and try again. If this message continues to appear please raise a bug report.</span>
                </p>
            }

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Are you registered to receive floodline warnings from the Environment Agency?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>See <a href="https://www.gov.uk/sign-up-for-flood-warnings" target="_blank" class="govuk-link">https://www.gov.uk/sign-up-for-flood-warnings</a> for more information</GdsHint>
                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.RegisteredWithFloodlineId">
                        @foreach (var registeredWithFloodLineOption in _registeredWithFloodlineOptions)
                        {
                            <GdsRadioItem>
                                <GdsInputRadio Value="@registeredWithFloodLineOption" />
                                <GdsRadioLabel Text="@registeredWithFloodLineOption.Label" />
                            </GdsRadioItem>
                        }
                    </GdsRadios>
                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading && _otherWarningOptions.Count <= 0)
            {
                <p class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span> <span>The other warning options are missing, please refresh and try again. If this message continues to appear please raise a bug report.</span>
                </p>
            }

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Did you get any other warnings of the flood from another source?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>For example, from the TV, radio, neighbours or somewhere else</GdsHint>
                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.OtherWarningId">
                        @foreach (var otherWarningOption in _otherWarningOptions)
                        {
                            <GdsRadioItem>
                                <GdsInputRadio Value="@otherWarningOption" />
                                <GdsRadioLabel Text="@otherWarningOption.Label" />
                            </GdsRadioItem>
                        }
                    </GdsRadios>
                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
