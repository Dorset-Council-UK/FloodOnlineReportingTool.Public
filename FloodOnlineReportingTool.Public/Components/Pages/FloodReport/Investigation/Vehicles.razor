@page "/floodreport/investigation/vehicles"
@using FloodOnlineReportingTool.Database.Models.Status
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationVehicles">
            <FluentValidationValidator />
            <GdsErrorSummary />

            @if (!_isLoading && _wereVehiclesDamagedOptions.Count <= 0)
            {
                <p class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span> <span>The vehicle options are missing, please refresh and try again. If this message continues to appear please raise a bug report.</span>
                </p>
            }

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Were any vehicles damaged as part of the flooding?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.WereVehiclesDamagedId">
                        @foreach (var option in _wereVehiclesDamagedOptions)
                        {
                            var conditionalId = option.Id == RecordStatusIds.Yes ? "conditional-yes" : null;
                            <GdsRadioItem>
                                <GdsInputRadio Value="@option.Id" ConditionalId="@conditionalId"></GdsInputRadio>
                                <GdsRadioLabel Text="@option.Text" />
                            </GdsRadioItem>
                            if (conditionalId != null)
                            {
                                <GdsRadioConditional Id="@conditionalId">
                                    <GdsFormGroup>
                                        <GdsLabel Text="How many vehicles were damaged?" />
                                        <GdsErrorMessage />
                                        <GdsInputNumber @bind-Value="Model.NumberOfVehiclesDamagedText" @bind-NumberValue="Model.NumberOfVehiclesDamagedNumber" class="govuk-input govuk-input--width-5" />
                                    </GdsFormGroup>
                                </GdsRadioConditional>
                            }
                        }
                    </GdsRadios>

                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
