@page "/floodreport/investigation/speed"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationSpeed">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">How quickly did the flooding start?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>Select one option.</GdsHint>
                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.Begin">
                        @foreach (var beginOption in _beginOptions)
                        {
                            <GdsRadioItem>
                                <GdsInputRadio Value="@beginOption.Id" />
                                <GdsRadioLabel Text="@beginOption.TypeName" />
                            </GdsRadioItem>
                        }
                    </GdsRadios>
                </GdsFieldsetGroup>
            </GdsFormGroup>
            
            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">How fast was the water moving?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>Select one option.</GdsHint>
                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.WaterSpeed">
                        @foreach (var waterSpeedOption in _waterSpeedOptions)
                        {
                            <GdsRadioItem>
                                <GdsInputRadio Value="@waterSpeedOption.Id" />
                                <GdsRadioLabel Text="@waterSpeedOption.TypeName" />
                            </GdsRadioItem>
                        }
                    </GdsRadios>
                </GdsFieldsetGroup>
            </GdsFormGroup>

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">What did the water look like?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>Select one option.</GdsHint>
                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.Appearance">
                        @foreach (var appearanceOption in _appearanceOptions)
                        {
                            <GdsRadioItem>
                                <GdsInputRadio Value="@appearanceOption.Id" />
                                <GdsRadioLabel Text="@appearanceOption.TypeName" />
                            </GdsRadioItem>
                        }
                    </GdsRadios>
                </GdsFieldsetGroup>
            </GdsFormGroup>

            <GdsFormGroup Show="!_isLoading" AdditionalCssClasses="govuk-character-count govuk-!-margin-top-4" DataModule="govuk-character-count" DataMaxLength="200">
                <h2 class="govuk-label-wrapper">
                    <GdsLabel Text="Can you provide more detail of the appearance? (optional)" AdditionalCssClasses="govuk-label--m" />
                </h2>
                <GdsHint>Do not include personal or financial information</GdsHint>
                <GdsErrorMessage />
                <InputTextArea id="@nameof(Model.MoreDetails)" @bind-Value="Model.MoreDetails" class="govuk-textarea govuk-js-character-count" rows="5" />
                <div id="@($"{nameof(Model.MoreDetails)}-info")" class="govuk-hint govuk-character-count__message">You can enter up to 200 characters</div>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
