@page "/floodreport/investigation/helpreceived"
@using Microsoft.AspNetCore.Components.Authorization
@using FloodOnlineReportingTool.Database.Models.Flood

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationHelpReceived">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Did you get any help for the flooding?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>Select all that apply</GdsHint>
                    <GdsErrorMessage />
                    
                    <GdsCheckboxes For="() => Model.HelpReceivedOptions">
                        @foreach (var helpReceived in HelpReceivedOptions)
                        {
                            string key = helpReceived.Id.ToString("N");
                            string id = $"help-received-{key}";
                            bool noHelpReceived = helpReceived.Id == FloodMitigationIds.NoHelp;
                            
                            if (noHelpReceived)
                            {
                                <GdsCheckboxDivider />
                            }
                            
                            <GdsCheckboxItem>
                                <GdsInputCheckbox Id="@id" @bind-Value="@SelectedHelpReceivedOptions[key]" OnChanged="isChecked => OnHelpReceivedChanged(isChecked, helpReceived.Id)" Exclusive="noHelpReceived" />
                                <GdsCheckboxLabel Text="@helpReceived.TypeName" />
                            </GdsCheckboxItem>
                        }
                    </GdsCheckboxes>

                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
