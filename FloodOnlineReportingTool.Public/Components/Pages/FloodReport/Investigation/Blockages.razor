@page "/floodreport/investigation/blockages"
@using FloodOnlineReportingTool.Database.Models.Status
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationBlockages">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            @if (!_isLoading && _blockageOptions.Count <= 0)
            {
                <p class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span> <span>The blockage options are missing, please refresh and try again. If this message continues to appear please raise a bug report.</span>
                </p>
            }

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Do you know of any problems, blockages, or recent repair works?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsErrorMessage />

                    <GdsRadios @bind-Value="Model.HasKnownProblemsId">
                        <GdsRadioItem>
                            <GdsInputRadio Value="@RecordStatusIds.Yes" ConditionalId="conditional-known" />
                            <GdsRadioLabel Text="Yes" />
                        </GdsRadioItem>
                        <GdsRadioConditional Id="conditional-known">
                            <GdsLabel Text="Describe the problems, blockages, or recent repair works" />
                            <GdsHint>Do not include personal or financial information</GdsHint>
                            <GdsErrorMessage />
                            <InputTextArea id="@nameof(Model.KnownProblemDetails)" @bind-Value="Model.KnownProblemDetails" class="govuk-textarea govuk-js-character-count" rows="5" />
                            <div id="@($"{nameof(Model.KnownProblemDetails)}-info")" class="govuk-hint govuk-character-count__message">You can enter up to 200 characters</div>
                        </GdsRadioConditional>

                        <GdsRadioItem>
                            <GdsInputRadio Value="@RecordStatusIds.No" />
                            <GdsRadioLabel Text="No" />
                        </GdsRadioItem>

                    </GdsRadios>

                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
