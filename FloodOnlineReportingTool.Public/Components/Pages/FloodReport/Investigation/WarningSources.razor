@page "/floodreport/investigation/warningsources"
@using FloodOnlineReportingTool.Database.Models.Flood
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationWarningSources">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            <GdsFormGroup Show="!_isLoading">
                <GdsFieldsetGroup>
                    <GdsFieldsetLegend>
                        <GdsFieldsetHeading Level="2">Where did you receive warnings from?</GdsFieldsetHeading>
                    </GdsFieldsetLegend>

                    <GdsHint>Select all that apply</GdsHint>
                    <GdsErrorMessage />

                    <GdsCheckboxes For="() => Model.WarningSourceOptions">
                    @foreach (var warningSource in WarningSourceOptions)
                    {
                        string key = warningSource.Id.ToString("N");
                        string id = $"warning-source-{key}";
                        bool noWarningSource = warningSource.Id == FloodMitigationIds.NoWarning;
                        var conditionalId = warningSource.Id == FloodMitigationIds.OtherWarning ? "conditional-other" : null;
                        
                        if (noWarningSource)
                        {
                            <GdsCheckboxDivider />
                        }
                        
                        <GdsCheckboxItem>
                            <GdsInputCheckbox Id="@id" @bind-Value="@SelectedWarningSourceOptions[key]" OnChanged="isChecked => OnWarningSourceChanged(isChecked, warningSource.Id)" Exclusive="noWarningSource" ConditionalId="@conditionalId" />
                            <GdsCheckboxLabel Text="@warningSource.TypeName" />
                        </GdsCheckboxItem>
                        
                        if(conditionalId != null)
                        {
                            <GdsCheckboxConditional Id="@conditionalId">
                                <GdsFormGroup AdditionalCssClasses="govuk-character-count govuk-!-margin-top-4" DataModule="govuk-character-count" DataMaxLength="100">
                                    <h2 class="govuk-label-wrapper">
                                        <GdsLabel Text="Can you describe the other source?" AdditionalCssClasses="govuk-label--m" />
                                    </h2>
                                    <GdsHint>Do not include personal or financial information</GdsHint>
                                    <GdsErrorMessage />
                                    <InputTextArea id="@nameof(Model.WarningOther)" @bind-Value="Model.WarningOther" class="govuk-textarea govuk-js-character-count" rows="5" />
                                    <div id="@($"{nameof(Model.WarningOther)}-info")" class="govuk-hint govuk-character-count__message">You can enter up to 100 characters</div>
                                </GdsFormGroup>
                            </GdsCheckboxConditional>
                        }
                    }
                    </GdsCheckboxes>

                </GdsFieldsetGroup>
            </GdsFormGroup>

            @if (!_isLoading)
            {
                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
