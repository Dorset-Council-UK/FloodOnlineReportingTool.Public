@page "/floodreport/investigation/serviceimpact"
@using FloodOnlineReportingTool.Database.Models.Status
@using Microsoft.AspNetCore.Components.Authorization
@using FloodOnlineReportingTool.Database.Models.Flood

<PageTitle>@InvestigationPages.ServiceImpact.Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@InvestigationPages.ServiceImpact.Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationServiceImpact">
            <FluentValidationValidator />
            <GdsErrorSummary />

            <GdsSpinner Show="_isLoading" ShowMessage="true" />

            @if (!_isLoading)
            {  
                <GdsFormGroup>
                    <GdsFieldsetGroup>
                        <GdsFieldsetLegend>
                            <GdsFieldsetHeading Level="2">Were services affected by the flooding?</GdsFieldsetHeading>
                        </GdsFieldsetLegend>

                        <GdsHint>Select one option.</GdsHint>
                        <GdsErrorMessage />

                        <GdsRadios @bind-Value="Model.WereServicesImpactedId">
                            @foreach (var option in _wereServicesImpactedOptions)
                            {
                                bool isNotSure = option.Id == FloodImpactIds.ServiceImpactNotSure;
                                var conditionalId = option.Id == RecordStatusIds.Yes ? "were-services-impacted-yes" : null;
                                <GdsRadioItem>
                                    <GdsInputRadio Value="@option.Id" ConditionalId="@conditionalId" />
                                    <GdsRadioLabel Text="@option.Text" />
                                </GdsRadioItem>

                                if (conditionalId is not null)
                                {
                                    <GdsRadioConditional Id="@conditionalId">
                                        <GdsFormGroup>
                                            <GdsFieldsetGroup>
                                                <GdsFieldsetLegend>
                                                    <GdsFieldsetHeading Level="2">What services were affected?</GdsFieldsetHeading>
                                                </GdsFieldsetLegend>

                                                <GdsHint>Select all that apply</GdsHint>
                                                <GdsErrorMessage />

                                                <GdsCheckboxes For="() => Model.ImpactedServicesOptions">
                                                    @foreach (var impactedService in ServiceImpactOptions)
                                                    {
                                                        string key = impactedService.Id.ToString("N");
                                                        string id = $"impacted-service-{key}";
                                                        bool isNotSure = impactedService.Id == FloodImpactIds.ServiceImpactNotSure;

                                                        if (isNotSure)
                                                        {
                                                            <GdsCheckboxDivider />
                                                        }
                                                            
                                                        <GdsCheckboxItem>
                                                            <GdsInputCheckbox Id="@id" @bind-Value="@SelectedServiceImpactOptions[key]" OnChanged="isChecked => OnServiceImpactChanged(isChecked, impactedService.Id)" Exclusive="isNotSure" />
                                                            <GdsCheckboxLabel Text="@impactedService.TypeName" />
                                                        </GdsCheckboxItem>
                                                    }
                                                </GdsCheckboxes>

                                            </GdsFieldsetGroup>
                                        </GdsFormGroup>
                                    </GdsRadioConditional>
                                }
                            }
                        </GdsRadios>

                    </GdsFieldsetGroup>
                </GdsFormGroup>

                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
                
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
