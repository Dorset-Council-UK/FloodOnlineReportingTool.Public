@page "/floodreport/investigation/serviceimpact"
@using Microsoft.AspNetCore.Components.Authorization
@using FloodOnlineReportingTool.Database.Models.Flood

<PageTitle>@InvestigationPages.ServiceImpact.Title</PageTitle>

<GdsBackLink Href="@PreviousPage.Url" />

<GdsHeading Level="1">@InvestigationPages.ServiceImpact.Title</GdsHeading>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
    <Authorized>
        <EditForm EditContext="_editContext" OnValidSubmit="OnValidSubmit" FormName="InvestigationServiceImpact">
            <FluentValidationValidator />
            <GdsErrorSummary />

            @if (_isLoading)
            {  
                <GdsSpinner Show ShowMessage />
            }
            else
            {
                <GdsFormGroup>
                    <GdsFieldsetGroup>
                        <GdsFieldsetLegend>
                            <GdsFieldsetHeading Level="2">Were services affected by the flooding?</GdsFieldsetHeading>
                        </GdsFieldsetLegend>

                        <GdsHint>Select one option.</GdsHint>
                        <GdsErrorMessage />

                        <GdsRadios @bind-Value="Model.WereServicesImpactedId">
                            <GdsRadioItem>
                                <GdsInputRadio Value="@_yesOption?.Id" ConditionalId="were-services-impacted-yes" />
                                <GdsRadioLabel Text="@_yesOption?.Text" />
                            </GdsRadioItem>

                            <GdsRadioConditional Id="were-services-impacted-yes">
                                <GdsFormGroup>
                                    <GdsFieldsetGroup>
                                        <GdsFieldsetLegend>
                                            <GdsFieldsetHeading Level="2">What services were affected?</GdsFieldsetHeading>
                                        </GdsFieldsetLegend>

                                        <GdsHint>Select all that apply</GdsHint>
                                        <GdsErrorMessage />

                                        <GdsCheckboxes For="() => Model.ImpactedServices">
                                            @foreach (var impactedService in _serviceImpacts)
                                            {
                                                string key = impactedService.Id.ToString("N");
                                                string id = $"impacted-service-{key}";

                                                <GdsCheckboxItem>
                                                    <GdsInputCheckbox Id="@id" @bind-Value="@SelectedServiceImpact[key]" OnChanged="isChecked => OnServiceImpactChanged(isChecked, impactedService.Id)" />
                                                    <GdsCheckboxLabel Text="@impactedService.TypeName" />
                                                </GdsCheckboxItem>
                                            }
                                        </GdsCheckboxes>

                                    </GdsFieldsetGroup>
                                </GdsFormGroup>
                            </GdsRadioConditional>

                            <GdsRadioItem>
                                <GdsInputRadio Value="@_noOption?.Id" />
                                <GdsRadioLabel Text="@_noOption?.TypeName" />
                            </GdsRadioItem>

                            <GdsCheckboxDivider />

                            <GdsRadioItem>
                                <GdsInputRadio Value="@_notSureOption?.Id" />
                                <GdsRadioLabel Text="@_notSureOption?.TypeName" />
                            </GdsRadioItem>
                        </GdsRadios>

                    </GdsFieldsetGroup>
                </GdsFormGroup>

                <p><GdsButton IsSubmit="true" PreventDoubleClick Text="Continue" /></p>
            }
        </EditForm>
    </Authorized>
</AuthorizeView>
