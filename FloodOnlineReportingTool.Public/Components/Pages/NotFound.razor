<PageTitle>Page not found</PageTitle>

<GdsHeading Level="1">Page not found</GdsHeading>

<p>If you typed the web address, check it is correct.</p>

<p>If you pasted the web address, check you copied the entire address.</p>

<p>
    If the web address is correct or you selected a link or button,
    @if (ContactLink == null)
    {
        @ContactText
    }
    else
    {
        <GdsLink Href="@ContactLink.ToString()">@ContactText</GdsLink>
    }
    if you need to speak to someone.
</p>

@code {
    private Uri? ContactLink = new("https://dorset-self.achieveservice.com/service/flood-reporting-tool-feedback");
    private string ContactText = "contact a system administrator";
}